{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toptop.local/schemas/interaction.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "status",
    "description",
    "states",
    "transitions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string" },
    "status": {
      "enum": ["draft", "review", "stable", "deprecated"]
    },
    "description": { "type": "string" },
    "componentIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "trigger"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "trigger": { "type": "string" },
          "feedback": { "type": "string" },
          "duration": { "type": "string" },
          "easing": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "accessibility": {
      "type": "array",
      "items": { "type": "string" }
    },
    "edgeCases": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
